{
  "name": "tours-crawler",
  "version": "0.0.1",
  "type": "module",
  "description": "Test project for scrapping Netherlands tours",
  "dependencies": {
    "crawlee": "^3.0.0",
    "playwright": "*"
  },
  "devDependencies": {
